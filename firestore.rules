rules_version = '2';

// Nadie accede a la base de datos directamente desde internet.
//
// Todas las apps de NeoApp (panel, app de socios, preregistro) hablan con el
// backend, y el backend usa la cuenta de servicio (firebase-admin), que no
// pasa por estas reglas. Antes estaba abierto a cualquiera: con solo conocer
// el id del proyecto se podian leer, cambiar o borrar todos los datos.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
