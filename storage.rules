rules_version = '2';

// Nadie accede a los archivos directamente desde internet.
//
// El backend sube y borra con la cuenta de servicio (firebase-admin), que no
// pasa por estas reglas, y entrega enlaces firmados (getSignedUrl) que siguen
// funcionando con las reglas cerradas.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
